---
// "How we start": the same three promises (analysis, setup, support) and a closing call to action.
// Used at the end of every product page and the consulting page.
import { startClosing, startSteps } from '../data/product-details/start';
import type { StartStepId } from '../data/product-details/types';
import { company } from '../data/site';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Where the main button points; the pages pass a mailto link with a ready-made subject. */
  ctaHref: string;
  /** Rewords individual steps; the figures always stay the same. */
  overrides?: Partial<Record<StartStepId, string>>;
  closing?: string;
}

const { lang, ctaHref, overrides, closing } = Astro.props;
const t = useTranslations(lang);
const steps = startSteps.map((step) => ({
  value: step.value[lang],
  title: step.title[lang],
  text: overrides?.[step.id] ?? step.text[lang],
}));
---

<section class="section" aria-labelledby="start-title">
  <div class="container section-grid">
    <h2 class="eyebrow" id="start-title">{t('product.start')}</h2>
    <div class="start">
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <p class="figure">
                <strong>{s.value}</strong> {s.title}
              </p>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="closing">{closing ?? startClosing[lang]}</p>
      <div class="buttons">
        <a class="btn btn-accent" href={ctaHref}>{t('product.cta')}</a>
        <a class="btn btn-outline" href={company.phoneHref}>{company.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .start {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .steps p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .steps .figure {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .figure strong {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-accent);
  }

  .closing {
    max-width: 40rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    font-weight: 600;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 30rem) {
    .buttons .btn {
      flex: 1 1 100%;
    }
  }
</style>
