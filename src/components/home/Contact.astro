---
import { company } from '../../data/site';
import { type Lang, sectionIds, useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id={sectionIds[lang].contact} aria-labelledby="contact-label">
  <div class="container section-grid">
    <h2 class="eyebrow" id="contact-label">{t('contact.label')}</h2>

    <div class="content">
      <p class="lead">{t('contact.lead')}</p>
      <a class="email" href={`mailto:${company.email}`}>{company.email}</a>
      <div class="buttons">
        <!-- The demo request will open the contact form once it is built; until then it starts an email. -->
        <a class="btn btn-accent" href={`mailto:${company.email}?subject=Demo`}>{t('cta.demo')}</a>
        <a class="btn btn-outline" href={company.phoneHref}>{company.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
  }

  .lead {
    max-width: 38rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* The address is the visual anchor of the section, so it scales hard but may still wrap on tiny screens. */
  .email {
    font-size: clamp(2rem, 1rem + 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 30rem) {
    .buttons .btn {
      flex: 1 1 100%;
    }
  }
</style>
