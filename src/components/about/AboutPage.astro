---
// The About page. Both language routes render this component; the copy lives in src/data/about.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stats from '../home/Stats.astro';
import { about, aboutPaths } from '../../data/about';
import { company, foundingVars } from '../../data/site';
import { type Lang, useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = about[lang];
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<BaseLayout lang={lang} path={aboutPaths} title={`${t('about.label')} | COLAB`} description={`${c.title} ${c.lead}`}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{t('about.label')} · {t('aboutPage.since', foundingVars)}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="container section-grid">
      <h2 class="eyebrow" id="story-title">{c.storyLabel}</h2>
      <div class="story">
        {c.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section soft" aria-labelledby="principles-title">
    <div class="container section-grid">
      <h2 class="eyebrow" id="principles-title">{c.principlesLabel}</h2>
      <div>
        <p class="intro">{c.principlesIntro}</p>
        <ol class="principles">
          {
            c.principles.map((p, i) => (
              <li>
                <span class="no">{pad(i)}</span>
                <span class="principle">{p}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <div class="section dark">
    <div class="container section-grid">
      <span aria-hidden="true"></span>
      <div class="statement">
        <p class="today">{c.today}</p>
        <p class="success">{c.success}</p>
      </div>
    </div>
  </div>

  <Stats lang={lang} />

  <section class="section" aria-labelledby="difference-title">
    <div class="container section-grid">
      <h2 class="eyebrow" id="difference-title">{c.differenceLabel}</h2>
      <ul class="differences">
        {
          c.differences.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section soft" aria-labelledby="cta-title">
    <div class="container section-grid">
      <span aria-hidden="true"></span>
      <div class="cta">
        <h2 id="cta-title">{c.ctaTitle}</h2>
        <p>{c.ctaText}</p>
        <div class="buttons">
          <a class="btn btn-accent" href={`mailto:${company.email}`}>{company.email}</a>
          <a class="btn btn-outline" href={company.phoneHref}>{company.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-line);
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.25rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .lead {
    max-width: 36rem;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.45;
    color: var(--color-text);
  }

  .story p {
    max-width: 44rem;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .soft {
    background: var(--color-soft);
  }

  .intro {
    margin-bottom: 1.5rem;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  /* Principles read like a manifesto: big type, one per row, numbered like the product list. */
  .principles {
    border-top: 1px solid var(--color-ink);
  }

  .principles li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .no {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .principle {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .dark {
    background: var(--color-ink);
    color: #ffffff;
  }

  .statement {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 48rem;
  }

  .today {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.55;
    color: #d4d4d4;
  }

  .success {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent-on-dark);
  }

  .differences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
  }

  .differences li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .differences p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cta h2 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .cta p {
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 30rem) {
    .buttons .btn {
      flex: 1 1 100%;
    }
  }

  /* The empty first grid cell keeps the text aligned with the other sections; on phones it takes no space. */
  .section-grid > span:empty {
    display: none;
  }

  @media (min-width: 60rem) {
    .section-grid > span:empty {
      display: block;
    }
  }
</style>
