---
import Logo from './Logo.astro';
import { type Lang, localePath, sectionIds, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const ids = sectionIds[lang];
const home = localePath(lang, '/');
const otherLang: Lang = lang === 'tr' ? 'en' : 'tr';

// The anchors point at the home page so the menu also works from future sub-pages.
const links = [
  { href: `${home}#${ids.products}`, label: t('nav.products') },
  { href: `${home}#${ids.services}`, label: t('nav.services') },
  { href: `${home}#${ids.about}`, label: t('nav.about') },
  { href: `${home}#${ids.contact}`, label: t('nav.contact') },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <Logo lang={lang} />

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden" data-label-open>{t('nav.menu')}</span>
      <span class="visually-hidden" data-label-close hidden>{t('nav.close')}</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <div class="menu" id="site-menu" data-menu>
      <nav aria-label={t('nav.menu')}>
        <ul class="nav-list">
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
      <div class="actions">
        <a class="lang-switch" href={localePath(otherLang, path)} hreflang={otherLang} lang={otherLang}>
          {t('nav.switchLang')}
        </a>
        <a class="btn btn-dark" href={`${home}#${ids.contact}`}>{t('cta.demo')}</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Opens and closes the mobile menu. On desktop the menu is always visible, so this only matters below 960px.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    const labelOpen = toggle.querySelector<HTMLElement>('[data-label-open]');
    const labelClose = toggle.querySelector<HTMLElement>('[data-label-close]');
    const desktop = window.matchMedia('(min-width: 60rem)');

    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (labelOpen) labelOpen.hidden = open;
      if (labelClose) labelClose.hidden = !open;
      // Stop the page behind the open menu from scrolling on phones.
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));

    // Picking a link should take the user there and get the menu out of the way.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    // Escape closes the menu and puts focus back on the button, as keyboard users expect.
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // If the window grows to desktop size while the menu is open, reset it so nothing stays locked.
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  /* Mobile first: a hamburger button and a full-width panel that drops below the bar. */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 22px;
  }

  .menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* The three lines turn into a cross while the menu is open. */
  [data-open] .menu-icon span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  [data-open] .menu-icon span:nth-child(2) {
    opacity: 0;
  }
  [data-open] .menu-icon span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu {
    display: none;
    position: absolute;
    inset: 100% 0 auto 0;
    height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    padding: 1.5rem var(--gutter) 2rem;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    flex-direction: column;
    gap: 2rem;
  }

  [data-open] .menu {
    display: flex;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: block;
    padding: 0.9rem 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--color-line);
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  /* Desktop: everything sits in one row and the hamburger disappears. */
  @media (min-width: 60rem) {
    .menu-toggle {
      display: none;
    }

    .menu,
    [data-open] .menu {
      display: flex;
      position: static;
      height: auto;
      overflow: visible;
      padding: 0;
      border: 0;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex: 1;
      gap: 2rem;
    }

    .menu nav {
      margin-inline: auto;
    }

    .nav-list {
      flex-direction: row;
      gap: 2rem;
    }

    .nav-list a {
      padding: 0.5rem 0;
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0;
      border: 0;
    }

    .actions {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }
</style>
