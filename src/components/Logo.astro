---
// The COLAB logo, linking back to the home page.
// The source is the large PNG from the old site; Astro resizes it at build time and serves WebP,
// so visitors only download a small file. Swap in an SVG here once the company provides one.
import { Image } from 'astro:assets';
import logo from '../assets/brand/colab-logo.png';
import { type Lang, localePath } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Rendered height in pixels on desktop; phones get a slightly smaller logo through CSS. */
  height?: number;
}

const { lang, height = 40 } = Astro.props;
// Keep the original aspect ratio so the image never looks squashed.
const width = Math.round((logo.width / logo.height) * height);
---

<a class="logo" href={localePath(lang, '/')} style={`--logo-height: ${height}px`}>
  <!-- 1x and 2x versions are generated so the logo stays sharp on retina screens. -->
  <Image src={logo} alt="COLAB" width={width} height={height} densities={[1, 2]} format="webp" loading="eager" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    width: auto;
    height: calc(var(--logo-height) * 0.85);
  }

  @media (min-width: 60rem) {
    .logo img {
      height: var(--logo-height);
    }
  }
</style>
