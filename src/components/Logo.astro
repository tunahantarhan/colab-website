---
// A text wordmark that stands in for the real logo. Replace the markup with the SVG once we receive it.
import { type Lang, localePath, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The footer shows the wordmark without the tagline underneath. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = useTranslations(lang);
---

<a class="logo" href={localePath(lang, '/')} aria-label={`COLAB, ${t('brand.tagline')}`}>
  <span class="wordmark">COLAB<span class="dot">.</span></span>
  {!compact && <span class="tagline">{t('brand.tagline')}</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .logo:hover {
    color: var(--color-ink);
  }

  .wordmark {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  /* The dot borrows the green from the logo, while links and buttons use the teal accent. */
  .dot {
    color: var(--color-accent-2);
  }

  .tagline {
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }
</style>
