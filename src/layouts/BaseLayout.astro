---
// The shell every page uses: document head, header, footer and the shared styles.
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, languages, localePath, useTranslations, withBase } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The page path without the language prefix, used to link to the same page in the other language. */
  path?: string;
  title?: string;
  description?: string;
}

const { lang, path = '/', title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localePath(lang, path), Astro.site);
// Preview deployments (e.g. GitHub Pages) set this so search engines don't index a copy of the real site.
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      // Tell search engines that the Turkish and English pages are translations of each other.
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  /* The skip link stays off-screen until a keyboard user tabs to it. */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: #ffffff;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
